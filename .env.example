# ---------------------------------------------------------------- Discord ---
#
# The welcome screen shows the owner's live Discord profile. None of these are
# required: with all of them empty the card falls back to /character.webp and
# the page is exactly what it was. See DISCORD_OAUTH.md for the walkthrough.
#
# NOTHING HERE IS PUBLIC. These are read only inside the /api/discord functions
# and never reach the browser — which is why none of them carry Astro's
# PUBLIC_ prefix. Adding that prefix to any of them would ship the value to
# every visitor.

# From https://discord.com/developers/applications → your app → OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Written down once by /api/discord/callback after you approve the grant.
DISCORD_REFRESH_TOKEN=

# Only needed if a proxy rewrites the request origin, or if the redirect
# registered on the Discord application differs from <your site>/api/discord/callback.
DISCORD_REDIRECT_URI=

# The one that keeps working on serverless. A bot token reads the same public
# profile through /users/{id}, never expires and never rotates, so there is no
# grant to re-run. Tried before OAuth when set. See DISCORD_OAUTH.md.
DISCORD_BOT_TOKEN=

# Live online status, which no REST endpoint returns at any scope — it exists
# only as Gateway events over a socket a serverless function cannot hold open.
# Point this at a running presence-relay/ instance to get a status dot; leave
# it empty and the card simply draws no dot. See presence-relay/README.md.
DISCORD_PRESENCE_URL=

# ------------------------------------------------------------------ Hosting ---

# The canonical origin, used for canonical URLs and og:image. Must be the real
# deployed host: social scrapers drop relative URLs.
SITE_URL=

# Only if the sanitized profile endpoint is hosted somewhere other than this
# site. Left empty, the client reads /api/discord/profile on its own origin.
PUBLIC_DISCORD_PROFILE_ENDPOINT=
