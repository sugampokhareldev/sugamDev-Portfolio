---
/**
 * The cinematic handoff from the character-led About scene into the real
 * Capabilities interface. The supplied Kling clip plays in ordinary time —
 * scrolling never seeks it — and its white laptop close-up is blended into
 * the site's paper stock during the last half-second.
 */
interface Props { production?: boolean }
const { production = false } = Astro.props
---

<div class:list={['cap-shift', { 'cap-shift--production': production }]} data-cap-shift aria-hidden="true">
  <div class="cap-shift__stage">
    <video
      class="cap-shift__video"
      data-cap-shift-video
      src="/video/about-to-capabilities.mp4"
      poster="/art/about-to-capabilities-start.webp"
      preload="auto"
      muted
      playsinline
      tabindex="-1"
    ></video>

    <div class="cap-shift__paper"></div>

    <div class="cap-shift__label">
      <span>03 / Capabilities</span>
      <span>Enter the build</span>
    </div>
  </div>
</div>

<style>
  .cap-shift {
    --finish: 0;
    position: relative;
    height: 155svh;
    margin-top: -1px;
    background: #000004;
  }

  .cap-shift--production { height: 145svh; }

  .cap-shift__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #000004;
  }

  .cap-shift__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(calc(1 + var(--finish) * 0.025));
    transform-origin: 62% 48%;
  }

  .cap-shift__paper {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--sheet-2);
    opacity: var(--finish);
  }

  .cap-shift__label {
    position: absolute;
    z-index: 2;
    left: var(--pad);
    right: var(--pad);
    bottom: clamp(1.5rem, 4vh, 3rem);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--sheet-muted);
    font: 500 0.65rem/1 var(--font-mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    opacity: calc(1 - var(--finish));
  }

  .cap-shift__label span:last-child { color: var(--sheet); }

  :global(.nav.cap-shift-dark) { color: var(--sheet); }
  :global(.nav.cap-shift-dark.is-scrolled) {
    background: rgba(19, 19, 23, 0.9);
    backdrop-filter: blur(10px);
  }
  :global(.nav.cap-shift-dark .nav__links a) { color: var(--sheet-muted); }
  :global(.nav.cap-shift-dark .nav__links a:hover),
  :global(.nav.cap-shift-dark .nav__links a.is-active) { color: var(--sheet); }

  @media (max-width: 700px) {
    .cap-shift { height: 135svh; }
    .cap-shift--production { height: 138svh; }
    .cap-shift__video { object-position: 65% 50%; }
    .cap-shift__label span:last-child { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cap-shift { display: none; }
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>('[data-cap-shift]')
  const video = host?.querySelector<HTMLVideoElement>('[data-cap-shift-video]')
  const nav = document.querySelector<HTMLElement>('[data-header]')
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)')

  if (host && video && !reduceMotion.matches) {
    let watching = false
    let started = false
    let frame = 0

    const clamp = (value: number) => Math.min(1, Math.max(0, value))

    const paint = () => {
      const duration = Number.isFinite(video.duration) ? video.duration : 5.54
      const finish = clamp((video.currentTime - (duration - 0.58)) / 0.58)
      host.style.setProperty('--finish', finish.toFixed(3))
      nav?.classList.toggle('cap-shift-dark', finish < 0.42)

      if (!video.paused && !video.ended) frame = requestAnimationFrame(paint)
    }

    const play = () => {
      if (!watching || document.hidden || video.ended) return
      if (!started) {
        started = true
        video.currentTime = 0
      }

      video.play().then(() => {
        cancelAnimationFrame(frame)
        frame = requestAnimationFrame(paint)
      }).catch(() => {
        // The final poster already matches the paper handoff if autoplay is
        // unavailable; the real Capabilities content remains directly below.
      })
    }

    const pause = () => {
      video.pause()
      cancelAnimationFrame(frame)
      nav?.classList.remove('cap-shift-dark')
    }

    const observer = new IntersectionObserver(([entry]) => {
      watching = entry.isIntersecting
      if (watching) play()
      else pause()
    }, { rootMargin: '-35% 0px -35% 0px', threshold: 0 })

    video.pause()
    observer.observe(host)

    video.addEventListener('ended', () => {
      host.style.setProperty('--finish', '1')
      nav?.classList.remove('cap-shift-dark')
      cancelAnimationFrame(frame)
    })

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause()
      else play()
    })
  }
</script>
