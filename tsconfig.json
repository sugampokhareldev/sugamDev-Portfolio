{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // `@/*` -> `src/*`, the alias shadcn generates and that its components
    // import each other by. Astro reads these paths through Vite, so no
    // separate vite.resolve.alias entry is needed.
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}